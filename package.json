{
  "name": "cambridge",
  "version": "1.0.0",
  "description": "An analog world clock art piece for a portrait screen in London.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Nat Welch <nat@natwelch.com>",
  "repository": "https://github.com/icco/cambridge.git",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "next dev -p 8080",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "type-check": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm type-check && pnpm format:check",
    "test:smoke": "node scripts/smoke.mjs",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@icco/react-common": "^2026.11013.1",
    "jsdom": "^30.1.3",
    "next": "^16.4.2",
    "openmeteo": "1.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "suncalc": "^2.1.1"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "daisyui": "^5.7.50",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
